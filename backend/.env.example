PORT=3000
# Optional: public URL used in the email verification link (no trailing slash).
# Defaults to the address the request came in on.
# Local: http://localhost:5173   Render: https://your-app.onrender.com
APP_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Bodha_AI?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: Gemini models to try in order (comma-separated)
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash,gemini-flash-lite-latest

# Mistral AI API Key (last-resort fallback when every Gemini model fails)
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily Web Search API Key (for Real-time Web Search)
TAVILY_API_KEY=your_tavily_api_key_here

# Email verification, sent through the Gmail API (enable it in Google Cloud).
# The refresh token needs the https://mail.google.com/ or gmail.send scope.
GOOGLE_USER=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
