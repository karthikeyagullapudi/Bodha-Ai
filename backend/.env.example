PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Bodha_AI?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral AI API Key (for Chat Titles)
MISTRAL_API_KEY=your_mistral_api_key_here

# Tavily Web Search API Key (for Real-time Web Search)
TEVILY_API_KEY=your_tavily_api_key_here

# Nodemailer / Email verification credentials (Optional)
GOOGLE_USER=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
